<Window x:Class="UP_New.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход" Height="280" Width="350" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20">
        <TextBlock Text="Логин:" FontWeight="Bold"/>
        <TextBox x:Name="TxtLogin" Margin="0,0,0,10"/>
        <TextBlock Text="Пароль:" FontWeight="Bold"/>
        <PasswordBox x:Name="TxtPass" Margin="0,0,0,20"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Войти" Width="100" Margin="5" Click="BtnLogin_Click"/>
            <Button Content="Регистрация" Width="100" Margin="5" Click="BtnRegister_Click"/>
        </StackPanel>
    </StackPanel>
</Window>