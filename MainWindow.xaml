<Window x:Class="UP_New.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Читай, Пиши и не спиши" Height="600" Width="900">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Background="#2C3E50" Grid.Column="0">
            <Button ToolTip="Профиль" Click="Nav_Click" Tag="Profile" Background="Transparent" BorderThickness="0" Padding="5">
                <TextBlock Text="👤" FontSize="28"/>
            </Button>
            <Button ToolTip="Каталог" Click="Nav_Click" Tag="Catalog" Background="Transparent" BorderThickness="0" Padding="5">
                <TextBlock Text="📚" FontSize="28"/>
            </Button>
            <Button ToolTip="Списки" Click="Nav_Click" Tag="Lists" Background="Transparent" BorderThickness="0" Padding="5">
                <TextBlock Text="📖" FontSize="28"/>
            </Button>
            <Button x:Name="BtnAuthor" ToolTip="Кабинет автора" Click="Nav_Click" Tag="Author" Background="Transparent" BorderThickness="0" Padding="5" Visibility="Collapsed">
                <TextBlock Text="✍️" FontSize="28"/>
            </Button>
            <Button x:Name="BtnAdmin" ToolTip="Администрирование" Click="Nav_Click" Tag="Admin" Background="Transparent" BorderThickness="0" Padding="5" Visibility="Collapsed">
                <TextBlock Text="⚙️" FontSize="28"/>
            </Button>
        </StackPanel>

        <Frame x:Name="MainFrame" Grid.Column="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>