<Page x:Class="UP_New.Pages.CatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Каталог">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Поиск и фильтры -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <TextBox x:Name="TxtSearch" Width="200" Margin="0,0,10,0" TextChanged="TxtSearch_TextChanged"/>
            <ComboBox x:Name="CbGenre" Width="150" Margin="0,0,10,0" DisplayMemberPath="GenreName" SelectedValuePath="GenreID"/>
            <Button Content="🔍" Width="40" Click="BtnSearch_Click"/>
            <Button Content="⬆️ По имени" Width="100" Margin="5,0,0,0" Click="SortByName_Click"/>
            <Button Content="⭐ По рейтингу" Width="110" Margin="5,0,0,0" Click="SortByRating_Click"/>
        </StackPanel>

        <DataGrid x:Name="DgBooks" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                  MouseDoubleClick="DgBooks_MouseDoubleClick" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Обложка" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Gray" BorderThickness="1" Margin="5" CornerRadius="3">
                                <Image Source="{Binding Path=CoverPath}" 
                                       Width="70" 
                                       Height="90" 
                                       Stretch="Uniform"
                                       StretchDirection="DownOnly"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="2*"/>
                <DataGridTextColumn Header="Автор" Binding="{Binding Author}" Width="*"/>
                <DataGridTextColumn Header="Жанры" Binding="{Binding Genres}" Width="*"/>
                <DataGridTextColumn Header="Рейтинг" Binding="{Binding AvgRating}" Width="80"/>
                <DataGridTemplateColumn Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="➕" ToolTip="В список" Click="AddToList_Click" Tag="{Binding BookID}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>