<Page x:Class="UP_NEW.Pages.BookDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Книга">
    <ScrollViewer Padding="15">
        <StackPanel>
            <!-- Информация о книге -->
            <TextBlock x:Name="TbTitle" FontSize="24" FontWeight="Bold"/>
            <TextBlock x:Name="TbMeta" FontStyle="Italic" Margin="0,5,0,15"/>

            <!-- Содержимое книги -->
            <TextBlock Text="Содержимое:" FontWeight="Bold"/>
            <TextBox x:Name="TbContent" IsReadOnly="True" Height="200" TextWrapping="Wrap" Margin="0,0,0,15"/>

            <!-- Кнопки жалоб -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBox x:Name="TxtBookComplaint" Width="200" Margin="0,0,5,0"/>
                <Button Content="⚠️ Жалоба на книгу" Click="ComplainBook_Click" Margin="0,0,10,0"/>
                <Button Content="⚠️ Жалоба на автора" Click="ComplainAuthor_Click" Margin="0,0,10,0"/>
                <Button x:Name="BtnFreezeBook" Content="❄️ Заморозить книгу" Click="FreezeBook_Click" 
                        Visibility="Collapsed" Background="Red" Foreground="White"/>
            </StackPanel>

            <!-- 🔥 ФОРМА ДОБАВЛЕНИЯ ОТЗЫВА (НОВОЕ) 🔥 -->
            <GroupBox Header="✍️ Оставить отзыв" Padding="10" Margin="0,15,0,15" BorderBrush="#4CAF50">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Текст отзыва:" VerticalAlignment="Top" Margin="0,0,10,5" Grid.Row="0"/>
                    <TextBox x:Name="TxtReviewText" Grid.Row="0" Grid.Column="1" Height="60" TextWrapping="Wrap" Margin="0,0,0,5"/>

                    <TextBlock Text="Оценка (1-10):" VerticalAlignment="Top" Margin="0,0,10,5" Grid.Row="1"/>
                    <ComboBox x:Name="CbRating" Grid.Row="1" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,0,0,5">
                        <ComboBoxItem Content="1"/>
                        <ComboBoxItem Content="2"/>
                        <ComboBoxItem Content="3"/>
                        <ComboBoxItem Content="4"/>
                        <ComboBoxItem Content="5"/>
                        <ComboBoxItem Content="6"/>
                        <ComboBoxItem Content="7"/>
                        <ComboBoxItem Content="8"/>
                        <ComboBoxItem Content="9"/>
                        <ComboBoxItem Content="10" IsSelected="True"/>
                    </ComboBox>

                    <Button Content="📤 Опубликовать отзыв" Grid.Row="2" Grid.Column="1" 
                            Width="180" HorizontalAlignment="Left" 
                            Click="AddReview_Click" 
                            Background="#4CAF50" Foreground="White" 
                            FontWeight="Bold" Padding="10,5" Margin="0,5,0,0"/>
                </Grid>
            </GroupBox>
            <!-- 🔥 КОНЕЦ ФОРМЫ ОТЗЫВА 🔥 -->

            <!-- Список отзывов -->
            <TextBlock Text="Отзывы:" FontSize="18" FontWeight="Bold" Margin="0,10,0,5"/>
            <DataGrid x:Name="DgReviews" AutoGenerateColumns="False" Height="150">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Пользователь" Binding="{Binding User}" Width="*"/>
                    <DataGridTextColumn Header="Оценка" Binding="{Binding Rating}" Width="60"/>
                    <DataGridTextColumn Header="Текст" Binding="{Binding ReviewText}" Width="2*"/>
                    <DataGridTemplateColumn Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="⚠️ Жалоба" Click="ComplainReview_Click" Tag="{Binding ReviewID}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="80" x:Name="ColAdminReview">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="❄️ Заморозить" Click="FreezeReview_Click" Tag="{Binding ReviewID}" Background="Red" Foreground="White"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</Page>